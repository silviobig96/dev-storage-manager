{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions for the main application window",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "allow-get-app-health",
    "allow-list-workspaces",
    "allow-select-and-add-workspace",
    "allow-remove-workspace",
    "allow-set-workspace-enabled",
    "allow-check-workspace",
    "allow-skip-workspace-setup"
  ]
}
